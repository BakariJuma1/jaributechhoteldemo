# ─── Firebase (client-side) ───────────────────────────────────────────────────
# Get from: Firebase Console → Project Settings → Your Apps → Web App
VITE_FIREBASE_API_KEY=your_api_key_here
VITE_FIREBASE_AUTH_DOMAIN=your_project_id.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your_project_id
VITE_FIREBASE_STORAGE_BUCKET=your_project_id.appspot.com
VITE_FIREBASE_MESSAGING_SENDER_ID=your_messaging_sender_id
VITE_FIREBASE_APP_ID=your_app_id

# ─── Cloudinary (server-side only — never exposed to browser) ─────────────────
# Get from: Cloudinary Console → Settings → Access Keys
# CLOUDINARY_API_SECRET must stay secret — never prefix it with VITE_
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret
